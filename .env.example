# Public URL used by users in the browser.
# In Coolify, set these after you choose the domain for the nginx service.
AGENTA_WEB_URL=https://agenta.example.com
AGENTA_API_URL=https://agenta.example.com/api
AGENTA_SERVICES_URL=https://agenta.example.com/services
AGENTA_ALLOWED_DOMAINS=agenta.example.com

# Generate these with: ./scripts/generate-secrets.sh
AGENTA_AUTH_KEY=replace-with-generated-secret
AGENTA_CRYPT_KEY=replace-with-generated-secret
SUPERTOKENS_API_KEY=replace-with-generated-secret
POSTGRES_PASSWORD=replace-with-generated-password

# Use a fixed release tag when you want predictable upgrades.
# Latest upstream tag seen while creating this repo: v0.99.9.
AGENTA_WEB_IMAGE_TAG=latest
AGENTA_API_IMAGE_TAG=latest
AGENTA_SERVICES_IMAGE_TAG=latest

# Optional provider keys for playground/evaluation features.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Keep disabled unless you intentionally opt in.
AGENTA_TELEMETRY_ENABLED=false
